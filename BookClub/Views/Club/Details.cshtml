@model ClubDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
    var defaultCover = Url.Content("~/img/default-cover.png");
}

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none fw-semibold">
        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Voltar para Meus Clubes
    </a>
</div>

<section class="bc-card p-4 mb-4" aria-labelledby="club-title">
    <div class="row g-3 align-items-start">
        <div class="col-lg-8">
            <div class="d-flex flex-wrap gap-2 mb-2">
                @if (Model.IsPrivate)
                {
                    <span class="bc-badge bc-badge-private">
                        <i class="bi bi-lock" aria-hidden="true"></i> Clube Privado
                    </span>
                }
                else
                {
                    <span class="bc-badge bc-badge-public">
                        <i class="bi bi-globe2" aria-hidden="true"></i> Clube Público
                    </span>
                }

                @if (Model.IsOwner)
                {
                    <span class="bc-badge bc-badge-owner">
                        <i class="bi bi-shield-check" aria-hidden="true"></i> Administrador
                    </span>
                }
                else if (Model.IsMember)
                {
                    <span class="bc-badge bc-badge-member">
                        <i class="bi bi-person" aria-hidden="true"></i> Membro
                    </span>
                }
                else if (Model.IsPending)
                {
                    <span class="bc-badge bc-badge-owner">
                        <i class="bi bi-hourglass-split" aria-hidden="true"></i> Solicitação pendente
                    </span>
                }

                <span class="bc-badge bc-badge-finished">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    @Model.Members.Count @(Model.Members.Count == 1 ? "membro" : "membros")
                </span>
            </div>

            <h1 id="club-title" class="h2 fw-bold mb-2">@Model.Name</h1>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="text-muted-accessible mb-0" style="white-space: pre-line;">@Model.Description</p>
            }
            else
            {
                <p class="text-muted-accessible fst-italic mb-0">Nenhuma descrição cadastrada para este clube.</p>
            }
        </div>

        <div class="col-lg-4 d-flex flex-column gap-2">
            @if (Model.IsOwner)
            {
                <div class="invite-code-box d-flex justify-content-between align-items-center gap-2">
                    <div>
                        <div class="small text-muted-accessible fw-semibold">Código de convite</div>
                        <div class="invite-code-value" aria-label="Código de convite @Model.InviteCode">@Model.InviteCode</div>
                    </div>
                    <button type="button"
                            class="btn btn-sm btn-bc-outline"
                            data-copy-text="@Model.InviteCode"
                            aria-label="Copiar código de convite @Model.InviteCode">
                        <i class="bi bi-clipboard" aria-hidden="true"></i> Copiar
                    </button>
                </div>

                <a asp-controller="ClubBook" asp-action="Add" asp-route-clubId="@Model.Id" class="btn btn-bc-primary w-100">
                    <i class="bi bi-journal-plus" aria-hidden="true"></i> Adicionar Livro
                </a>

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm flex-grow-1">
                        <i class="bi bi-pencil" aria-hidden="true"></i> Editar Clube
                    </a>
                    <button type="button"
                            class="btn btn-outline-danger btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteClubModal">
                        <i class="bi bi-trash" aria-hidden="true"></i> Excluir
                    </button>
                </div>
            }
            else if (Model.IsMember)
            {
                <button type="button"
                        class="btn btn-outline-danger w-100"
                        data-bs-toggle="modal"
                        data-bs-target="#leaveClubModal">
                    <i class="bi bi-box-arrow-left" aria-hidden="true"></i> Sair do Clube
                </button>
            }
            else if (Model.IsPending)
            {
                <div class="p-3 rounded-3 bg-light border text-center small text-muted-accessible">
                    <i class="bi bi-hourglass-split text-warning me-1" aria-hidden="true"></i>
                    Sua solicitação aguarda aprovação do administrador.
                </div>
                <form asp-action="CancelRequest" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                        <i class="bi bi-x-circle" aria-hidden="true"></i> Cancelar solicitação
                    </button>
                </form>
            }
            else if (!Model.IsPrivate)
            {
                <form asp-action="Join" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-bc-primary w-100 btn-lg">
                        <i class="bi bi-person-plus" aria-hidden="true"></i> Solicitar Entrada
                    </button>
                </form>
            }
        </div>
    </div>
</section>

<ul class="nav nav-pills bc-tabs mb-4" id="clubTabs" role="tablist" aria-label="Seções do clube">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.ActiveTab == "current" ? "active" : "")"
                id="tab-current"
                data-bs-toggle="pill"
                data-bs-target="#pane-current"
                type="button"
                role="tab"
                aria-controls="pane-current"
                aria-selected="@(Model.ActiveTab == "current" ? "true" : "false")">
            <i class="bi bi-book" aria-hidden="true"></i>
            <span>Leitura Atual</span>
            <span class="badge bg-light text-dark rounded-pill">@Model.CurrentBooks.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.ActiveTab == "upcoming" ? "active" : "")"
                id="tab-upcoming"
                data-bs-toggle="pill"
                data-bs-target="#pane-upcoming"
                type="button"
                role="tab"
                aria-controls="pane-upcoming"
                aria-selected="@(Model.ActiveTab == "upcoming" ? "true" : "false")">
            <i class="bi bi-calendar-event" aria-hidden="true"></i>
            <span>Próximas Leituras</span>
            <span class="badge bg-light text-dark rounded-pill">@Model.UpcomingBooks.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.ActiveTab == "finished" ? "active" : "")"
                id="tab-finished"
                data-bs-toggle="pill"
                data-bs-target="#pane-finished"
                type="button"
                role="tab"
                aria-controls="pane-finished"
                aria-selected="@(Model.ActiveTab == "finished" ? "true" : "false")">
            <i class="bi bi-check-circle" aria-hidden="true"></i>
            <span>Já Lidos</span>
            <span class="badge bg-light text-dark rounded-pill">@Model.FinishedBooks.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.ActiveTab == "members" ? "active" : "")"
                id="tab-members"
                data-bs-toggle="pill"
                data-bs-target="#pane-members"
                type="button"
                role="tab"
                aria-controls="pane-members"
                aria-selected="@(Model.ActiveTab == "members" ? "true" : "false")">
            <i class="bi bi-people" aria-hidden="true"></i>
            <span>Membros</span>
            <span class="badge bg-light text-dark rounded-pill">@Model.Members.Count</span>
            @if (Model.IsOwner && Model.PendingRequests.Any())
            {
                <span class="badge bg-warning text-dark rounded-pill" title="Solicitações pendentes">
                    +@Model.PendingRequests.Count
                </span>
            }
        </button>
    </li>
</ul>

<div class="tab-content" id="clubTabsContent">
    <div class="tab-pane fade @(Model.ActiveTab == "current" ? "show active" : "")"
         id="pane-current" role="tabpanel" aria-labelledby="tab-current">
        @if (!Model.CurrentBooks.Any())
        {
            <div class="bc-card p-4 p-md-5 text-center">
                <i class="bi bi-book display-5 text-muted-accessible mb-3" aria-hidden="true"></i>
                <h2 class="h5 fw-bold mb-2">Nenhuma leitura atual no momento</h2>
                <p class="text-muted-accessible mb-3">
                    @(Model.IsOwner
                        ? "Adicione o livro que o grupo vai ler agora ou mova um livro da fila de próximas leituras."
                        : "O administrador ainda não definiu o livro que o clube está lendo agora.")
                </p>
                @if (Model.IsOwner)
                {
                    <a asp-controller="ClubBook" asp-action="Add" asp-route-clubId="@Model.Id" class="btn btn-bc-primary">
                        <i class="bi bi-journal-plus" aria-hidden="true"></i> Adicionar Leitura Atual
                    </a>
                }
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var book in Model.CurrentBooks)
                {
                    var coverSrc = string.IsNullOrWhiteSpace(book.CoverUrl) ? defaultCover : book.CoverUrl;
                    <article class="bc-card p-4">
                        <div class="d-flex flex-column flex-md-row gap-4">
                            <div class="text-center text-md-start">
                                <img src="@coverSrc"
                                     alt="Capa do livro @book.Title"
                                     class="book-cover-lg shadow-sm"
                                     onerror="this.onerror=null;this.src='/img/default-cover.png';" />
                            </div>

                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <span class="bc-badge bc-badge-current">
                                        <i class="bi bi-book-fill" aria-hidden="true"></i> Lendo Agora
                                    </span>
                                    @if (book.Pages.HasValue)
                                    {
                                        <span class="small text-muted-accessible">
                                            <i class="bi bi-file-earmark-text me-1" aria-hidden="true"></i>@book.Pages páginas
                                        </span>
                                    }
                                    @if (book.PublishedYear.HasValue)
                                    {
                                        <span class="small text-muted-accessible">
                                            • @book.PublishedYear
                                        </span>
                                    }
                                </div>

                                <h2 class="h4 fw-bold mb-1">@book.Title</h2>
                                <p class="text-muted-accessible fw-semibold mb-3">por @book.Author</p>

                                <div class="row g-2 mb-3">
                                    <div class="col-sm-6 col-lg-4">
                                        <div class="p-2 px-3 rounded-3 bg-light border">
                                            <div class="small text-muted-accessible">Data de início</div>
                                            <div class="fw-semibold">
                                                <i class="bi bi-calendar-play me-1 text-primary" aria-hidden="true"></i>
                                                @(book.StartDate.HasValue ? book.StartDate.Value.ToString("dd/MM/yyyy") : "Não definida")
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-6 col-lg-4">
                                        <div class="p-2 px-3 rounded-3 bg-light border">
                                            <div class="small text-muted-accessible">Término / Encontro previsto</div>
                                            <div class="fw-semibold">
                                                <i class="bi bi-calendar-check me-1 text-success" aria-hidden="true"></i>
                                                @(book.TargetFinishDate.HasValue ? book.TargetFinishDate.Value.ToString("dd/MM/yyyy") : "Não definida")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(book.Synopsis))
                                {
                                    <div class="mb-3">
                                        <h3 class="h6 fw-bold mb-1">Sinopse</h3>
                                        <p class="text-muted-accessible mb-0" style="white-space: pre-line;">@book.Synopsis</p>
                                    </div>
                                }

                                @if (Model.IsOwner)
                                {
                                    <div class="d-flex flex-wrap gap-2 pt-3 border-top">
                                        <form asp-controller="ClubBook" asp-action="UpdateStatus" method="post">
                                            <input type="hidden" name="id" value="@book.ClubBookId" />
                                            <input type="hidden" name="status" value="@ClubBookStatus.Finished" />
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="bi bi-check2-circle" aria-hidden="true"></i> Marcar como Concluído
                                            </button>
                                        </form>
                                        <a asp-controller="ClubBook" asp-action="Edit" asp-route-id="@book.ClubBookId" class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-pencil" aria-hidden="true"></i> Editar datas / status
                                        </a>
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#removeBookModal"
                                                data-book-id="@book.ClubBookId"
                                                data-book-title="@book.Title">
                                            <i class="bi bi-trash" aria-hidden="true"></i> Remover
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>

    <div class="tab-pane fade @(Model.ActiveTab == "upcoming" ? "show active" : "")"
         id="pane-upcoming" role="tabpanel" aria-labelledby="tab-upcoming">
        @if (!Model.UpcomingBooks.Any())
        {
            <div class="bc-card p-4 p-md-5 text-center">
                <i class="bi bi-calendar-event display-5 text-muted-accessible mb-3" aria-hidden="true"></i>
                <h2 class="h5 fw-bold mb-2">Nenhum livro planejado na fila</h2>
                <p class="text-muted-accessible mb-3">
                    @(Model.IsOwner
                        ? "Adicione os próximos livros para que todos os membros já possam se programar."
                        : "O administrador ainda não cadastrou os próximos livros do clube.")
                </p>
                @if (Model.IsOwner)
                {
                    <a asp-controller="ClubBook" asp-action="Add" asp-route-clubId="@Model.Id" class="btn btn-bc-primary">
                        <i class="bi bi-journal-plus" aria-hidden="true"></i> Adicionar Próximo Livro
                    </a>
                }
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @{ var index = 1; }
                @foreach (var book in Model.UpcomingBooks)
                {
                    var coverSrc = string.IsNullOrWhiteSpace(book.CoverUrl) ? defaultCover : book.CoverUrl;
                    <article class="bc-card p-3 p-md-4">
                        <div class="d-flex flex-column flex-sm-row gap-3">
                            <img src="@coverSrc"
                                 alt="Capa do livro @book.Title"
                                 class="book-cover-md"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='/img/default-cover.png';" />

                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <span class="bc-badge bc-badge-upcoming">
                                        <i class="bi bi-calendar-event" aria-hidden="true"></i> Próximo #@index
                                    </span>
                                    @if (book.Pages.HasValue)
                                    {
                                        <span class="small text-muted-accessible">@book.Pages páginas</span>
                                    }
                                    @if (book.StartDate.HasValue)
                                    {
                                        <span class="small text-muted-accessible">• Início previsto: @book.StartDate.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                    @if (book.TargetFinishDate.HasValue)
                                    {
                                        <span class="small text-muted-accessible">• Encontro: @book.TargetFinishDate.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                </div>

                                <h2 class="h5 fw-bold mb-1">@book.Title</h2>
                                <p class="text-muted-accessible small fw-semibold mb-2">por @book.Author</p>

                                @if (!string.IsNullOrWhiteSpace(book.Synopsis))
                                {
                                    <p class="small text-muted-accessible mb-2">
                                        @(book.Synopsis.Length > 260 ? book.Synopsis[..260] + "..." : book.Synopsis)
                                    </p>
                                }

                                @if (Model.IsOwner)
                                {
                                    <div class="d-flex flex-wrap gap-2 pt-2 border-top mt-2">
                                        <form asp-controller="ClubBook" asp-action="UpdateStatus" method="post">
                                            <input type="hidden" name="id" value="@book.ClubBookId" />
                                            <input type="hidden" name="status" value="@ClubBookStatus.Current" />
                                            <button type="submit" class="btn btn-bc-primary btn-sm">
                                                <i class="bi bi-play-fill" aria-hidden="true"></i> Iniciar Leitura
                                            </button>
                                        </form>
                                        <a asp-controller="ClubBook" asp-action="Edit" asp-route-id="@book.ClubBookId" class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-pencil" aria-hidden="true"></i> Editar
                                        </a>
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#removeBookModal"
                                                data-book-id="@book.ClubBookId"
                                                data-book-title="@book.Title">
                                            <i class="bi bi-trash" aria-hidden="true"></i> Remover
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </article>
                    index++;
                }
            </div>
        }
    </div>

    <div class="tab-pane fade @(Model.ActiveTab == "finished" ? "show active" : "")"
         id="pane-finished" role="tabpanel" aria-labelledby="tab-finished">
        @if (!Model.FinishedBooks.Any())
        {
            <div class="bc-card p-4 p-md-5 text-center">
                <i class="bi bi-check-circle display-5 text-muted-accessible mb-3" aria-hidden="true"></i>
                <h2 class="h5 fw-bold mb-2">Nenhum livro concluído ainda</h2>
                <p class="text-muted-accessible mb-0">
                    Assim que o clube finalizar uma leitura, ela ficará registrada aqui no histórico.
                </p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var book in Model.FinishedBooks)
                {
                    var coverSrc = string.IsNullOrWhiteSpace(book.CoverUrl) ? defaultCover : book.CoverUrl;
                    <div class="col-md-6">
                        <article class="bc-card p-3 h-100 d-flex gap-3">
                            <img src="@coverSrc"
                                 alt="Capa do livro @book.Title"
                                 class="book-cover-md"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='/img/default-cover.png';" />
                            <div class="flex-grow-1 d-flex flex-column">
                                <div class="mb-1">
                                    <span class="bc-badge bc-badge-finished">
                                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i> Concluído
                                    </span>
                                </div>
                                <h2 class="h6 fw-bold mb-1">@book.Title</h2>
                                <p class="small text-muted-accessible mb-1">por @book.Author</p>

                                <div class="small text-muted-accessible mb-2">
                                    @if (book.Pages.HasValue)
                                    {
                                        <span>@book.Pages págs.</span>
                                    }
                                    @if (book.TargetFinishDate.HasValue)
                                    {
                                        <span>@(book.Pages.HasValue ? " • " : "")Finalizado em @book.TargetFinishDate.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                </div>

                                @if (Model.IsOwner)
                                {
                                    <div class="mt-auto pt-2 border-top d-flex flex-wrap gap-2">
                                        <a asp-controller="ClubBook" asp-action="Edit" asp-route-id="@book.ClubBookId" class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-pencil" aria-hidden="true"></i> Editar
                                        </a>
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#removeBookModal"
                                                data-book-id="@book.ClubBookId"
                                                data-book-title="@book.Title">
                                            <i class="bi bi-trash" aria-hidden="true"></i> Remover
                                        </button>
                                    </div>
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>

    <div class="tab-pane fade @(Model.ActiveTab == "members" ? "show active" : "")"
         id="pane-members" role="tabpanel" aria-labelledby="tab-members">

        @if (Model.IsOwner && Model.PendingRequests.Any())
        {
            <div class="bc-card p-3 p-md-4 mb-4 border-warning">
                <h2 class="h5 fw-bold mb-3">
                    <i class="bi bi-person-exclamation text-warning me-1" aria-hidden="true"></i>
                    Solicitações Pendentes (@Model.PendingRequests.Count)
                </h2>
                <ul class="list-group list-group-flush">
                    @foreach (var req in Model.PendingRequests)
                    {
                        <li class="list-group-item px-0 py-3 d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="member-avatar" aria-hidden="true">@req.Initials</div>
                                <div>
                                    <div class="fw-bold">@req.FullName</div>
                                    <div class="small text-muted-accessible">
                                        Solicitou em @req.JoinedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <form asp-action="ApproveMember" method="post">
                                    <input type="hidden" name="clubId" value="@Model.Id" />
                                    <input type="hidden" name="userId" value="@req.UserId" />
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="bi bi-check2" aria-hidden="true"></i> Aprovar
                                    </button>
                                </form>
                                <form asp-action="RejectMember" method="post">
                                    <input type="hidden" name="clubId" value="@Model.Id" />
                                    <input type="hidden" name="userId" value="@req.UserId" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-x-lg" aria-hidden="true"></i> Recusar
                                    </button>
                                </form>
                                <button type="button"
                                        class="btn btn-outline-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#banMemberModal"
                                        data-member-id="@req.UserId"
                                        data-member-name="@req.FullName">
                                    <i class="bi bi-slash-circle" aria-hidden="true"></i> Banir
                                </button>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="bc-card p-3 p-md-4 mb-4">
            <h2 class="h5 fw-bold mb-3">Participantes do Clube (@Model.Members.Count)</h2>
            <ul class="list-group list-group-flush">
                @foreach (var member in Model.Members)
                {
                    <li class="list-group-item px-0 py-3 d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="member-avatar" aria-hidden="true">@member.Initials</div>
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="fw-bold">@member.FullName</span>
                                    @if (member.Role == ClubRole.Owner)
                                    {
                                        <span class="bc-badge bc-badge-owner">
                                            <i class="bi bi-shield-check" aria-hidden="true"></i> Administrador
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bc-badge bc-badge-member">
                                            <i class="bi bi-person" aria-hidden="true"></i> Membro
                                        </span>
                                    }
                                </div>
                                <div class="small text-muted-accessible">
                                    Entrou em @member.JoinedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                </div>
                            </div>
                        </div>

                        @if (Model.IsOwner && member.Role != ClubRole.Owner)
                        {
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#removeMemberModal"
                                        data-member-id="@member.UserId"
                                        data-member-name="@member.FullName">
                                    <i class="bi bi-person-dash" aria-hidden="true"></i> Remover
                                </button>
                                <button type="button"
                                        class="btn btn-outline-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#banMemberModal"
                                        data-member-id="@member.UserId"
                                        data-member-name="@member.FullName">
                                    <i class="bi bi-slash-circle" aria-hidden="true"></i> Banir
                                </button>
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>

        @if (Model.IsOwner && Model.BannedMembers.Any())
        {
            <div class="bc-card p-3 p-md-4">
                <h2 class="h6 fw-bold text-danger mb-3">
                    <i class="bi bi-slash-circle me-1" aria-hidden="true"></i>
                    Usuários Banidos (@Model.BannedMembers.Count)
                </h2>
                <ul class="list-group list-group-flush">
                    @foreach (var banned in Model.BannedMembers)
                    {
                        <li class="list-group-item px-0 py-3 d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-2">
                            <div class="d-flex align-items-center gap-3">
                                <div class="member-avatar bg-danger bg-opacity-10 text-danger" aria-hidden="true">@banned.Initials</div>
                                <div>
                                    <div class="fw-bold">@banned.FullName</div>
                                    <div class="small text-muted-accessible">
                                        Banido em @banned.JoinedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                    </div>
                                </div>
                            </div>
                            <form asp-action="UnbanMember" method="post">
                                <input type="hidden" name="clubId" value="@Model.Id" />
                                <input type="hidden" name="userId" value="@banned.UserId" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Desbanir
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

@if (Model.IsOwner)
{
    <div class="modal fade" id="removeBookModal" tabindex="-1" aria-labelledby="removeBookModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title h5 fw-bold" id="removeBookModalLabel">Remover livro do clube?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        Tem certeza que deseja remover <strong id="removeBookTitlePlaceholder">este livro</strong> do cronograma do clube?
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-controller="ClubBook" asp-action="Remove" method="post">
                        <input type="hidden" name="id" id="removeBookIdInput" value="" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash" aria-hidden="true"></i> Sim, remover
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="removeMemberModal" tabindex="-1" aria-labelledby="removeMemberModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title h5 fw-bold" id="removeMemberModalLabel">Remover membro do clube?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        Tem certeza que deseja remover <strong id="removeMemberNamePlaceholder">este membro</strong> do clube?
                        Ele poderá solicitar entrada novamente no futuro. Se quiser impedir novos pedidos, use a opção <strong>Banir</strong>.
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-action="RemoveMember" method="post">
                        <input type="hidden" name="clubId" value="@Model.Id" />
                        <input type="hidden" name="userId" id="removeMemberIdInput" value="" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-person-dash" aria-hidden="true"></i> Sim, remover
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="banMemberModal" tabindex="-1" aria-labelledby="banMemberModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title h5 fw-bold text-danger" id="banMemberModalLabel">Banir usuário do clube?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        Tem certeza que deseja banir <strong id="banMemberNamePlaceholder">este usuário</strong>?
                        Ele será removido do clube e ficará impedido de solicitar entrada ou usar o código de convite até que você remova o banimento.
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-action="BanMember" method="post">
                        <input type="hidden" name="clubId" value="@Model.Id" />
                        <input type="hidden" name="userId" id="banMemberIdInput" value="" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-slash-circle" aria-hidden="true"></i> Sim, banir
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteClubModal" tabindex="-1" aria-labelledby="deleteClubModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title h5 fw-bold text-danger" id="deleteClubModalLabel">Excluir clube permanentemente?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        Tem certeza que deseja excluir o clube <strong>@Model.Name</strong>? Todo o cronograma de leituras e a lista de membros deste clube serão removidos. Esta ação não pode ser desfeita.
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash" aria-hidden="true"></i> Sim, excluir clube
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.IsMember && !Model.IsOwner)
{
    <div class="modal fade" id="leaveClubModal" tabindex="-1" aria-labelledby="leaveClubModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title h5 fw-bold" id="leaveClubModalLabel">Sair do clube?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        Tem certeza que deseja sair do clube <strong>@Model.Name</strong>?
                        @if (Model.IsPrivate)
                        {
                            <span>Como o clube é privado, você precisará do código de convite caso queira voltar depois.</span>
                        }
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-action="Leave" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-box-arrow-left" aria-hidden="true"></i> Sim, sair do clube
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        const removeBookModal = document.getElementById('removeBookModal');
        if (removeBookModal) {
            removeBookModal.addEventListener('show.bs.modal', (event) => {
                const button = event.relatedTarget;
                if (!button) return;
                document.getElementById('removeBookIdInput').value = button.getAttribute('data-book-id') || '';
                document.getElementById('removeBookTitlePlaceholder').textContent = button.getAttribute('data-book-title') || 'este livro';
            });
        }

        const removeMemberModal = document.getElementById('removeMemberModal');
        if (removeMemberModal) {
            removeMemberModal.addEventListener('show.bs.modal', (event) => {
                const button = event.relatedTarget;
                if (!button) return;
                document.getElementById('removeMemberIdInput').value = button.getAttribute('data-member-id') || '';
                document.getElementById('removeMemberNamePlaceholder').textContent = button.getAttribute('data-member-name') || 'este membro';
            });
        }

        const banMemberModal = document.getElementById('banMemberModal');
        if (banMemberModal) {
            banMemberModal.addEventListener('show.bs.modal', (event) => {
                const button = event.relatedTarget;
                if (!button) return;
                document.getElementById('banMemberIdInput').value = button.getAttribute('data-member-id') || '';
                document.getElementById('banMemberNamePlaceholder').textContent = button.getAttribute('data-member-name') || 'este usuário';
            });
        }
    </script>
}
