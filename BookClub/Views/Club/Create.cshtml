@model ClubFormViewModel
@{
    ViewData["Title"] = "Criar Clube";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="mb-3">
            <a asp-action="Index" class="text-decoration-none fw-semibold">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Voltar para Meus Clubes
            </a>
        </div>

        <div class="bc-card p-4 p-md-5">
            <h1 class="h3 fw-bold mb-1">Criar um Novo Clube do Livro</h1>
            <p class="text-muted-accessible mb-4">
                Você será o administrador do clube e receberá automaticamente um código de convite para compartilhar com seu grupo.
            </p>

            <form asp-action="Create" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="Ex.: Clube dos Clássicos da Noite" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"
                              placeholder="Conte sobre o estilo de livros, frequência dos encontros e regras do clube (opcional)..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <fieldset class="mb-4">
                    <legend class="form-label fs-6 mb-2">Visibilidade do clube</legend>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="bc-card p-3 d-block h-100 cursor-pointer" for="visibilidadePublico">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="IsPrivate" id="visibilidadePublico"
                                           value="false" @(!Model.IsPrivate ? "checked" : "") />
                                    <span class="form-check-label fw-bold">
                                        <i class="bi bi-globe2 text-primary me-1" aria-hidden="true"></i> Público
                                    </span>
                                </div>
                                <p class="small text-muted-accessible mb-0 mt-1 ps-4">
                                    Aparece em "Explorar Clubes" e novos membros entram após sua aprovação.
                                </p>
                            </label>
                        </div>

                        <div class="col-sm-6">
                            <label class="bc-card p-3 d-block h-100 cursor-pointer" for="visibilidadePrivado">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="IsPrivate" id="visibilidadePrivado"
                                           value="true" @(Model.IsPrivate ? "checked" : "") />
                                    <span class="form-check-label fw-bold">
                                        <i class="bi bi-lock text-danger me-1" aria-hidden="true"></i> Privado
                                    </span>
                                </div>
                                <p class="small text-muted-accessible mb-0 mt-1 ps-4">
                                    Fica oculto da busca pública. Somente quem tiver o código de convite entra.
                                </p>
                            </label>
                        </div>
                    </div>
                </fieldset>

                <div class="d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-bc-primary btn-lg flex-grow-1">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i> Criar Clube
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
