@model RegisterViewModel
@{
    ViewData["Title"] = "Criar Conta";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="bc-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary mb-2" style="width: 56px; height: 56px;">
                    <i class="bi bi-person-plus fs-3" aria-hidden="true"></i>
                </div>
                <h1 class="h3 fw-bold mb-1">Criar sua conta</h1>
                <p class="text-muted-accessible mb-0">Comece a organizar ou participar de clubes do livro.</p>
            </div>

            <form asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autocomplete="given-name" placeholder="Ex.: Maria" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Surname" class="form-label"></label>
                        <input asp-for="Surname" class="form-control" autocomplete="family-name" placeholder="Ex.: Silva" />
                        <span asp-validation-for="Surname" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" autocomplete="email" placeholder="voce@exemplo.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="Mínimo de 6 caracteres" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repita sua senha" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-bc-primary w-100 btn-lg mb-3">
                    <i class="bi bi-check2-circle" aria-hidden="true"></i> Criar conta
                </button>

                <p class="text-center text-muted-accessible mb-0">
                    Já possui conta?
                    <a asp-action="Login" class="fw-semibold text-decoration-none">Entrar agora</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
