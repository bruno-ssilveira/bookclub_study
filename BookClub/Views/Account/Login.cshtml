@model LoginViewModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="bc-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary mb-2" style="width: 56px; height: 56px;">
                    <i class="bi bi-box-arrow-in-right fs-3" aria-hidden="true"></i>
                </div>
                <h1 class="h3 fw-bold mb-1">Entrar no BookClub</h1>
                <p class="text-muted-accessible mb-0">Acesse seus clubes e acompanhe suas leituras.</p>
            </div>

            <form asp-action="Login" method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" autocomplete="email" placeholder="voce@exemplo.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Sua senha" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-bc-primary w-100 btn-lg mb-3">
                    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Entrar
                </button>

                <p class="text-center text-muted-accessible mb-0">
                    Ainda não tem conta?
                    <a asp-action="Register" class="fw-semibold text-decoration-none">Criar conta gratuita</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
