@model ErrorViewModel
@{
    ViewData["Title"] = "Ops! Algo deu errado";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6">
        <div class="bc-card p-4 p-md-5 text-center">
            <i class="bi bi-exclamation-octagon text-danger display-4 mb-3" aria-hidden="true"></i>
            <h1 class="h3 fw-bold mb-2">Algo inesperado aconteceu</h1>
            <p class="text-muted-accessible mb-4">
                Não foi possível concluir sua solicitação no momento. Tente novamente em instantes.
            </p>
            @if (Model?.ShowRequestId == true)
            {
                <p class="small text-muted-accessible mb-4">
                    Código de referência: <code>@Model.RequestId</code>
                </p>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-bc-primary">
                <i class="bi bi-house" aria-hidden="true"></i> Voltar para o início
            </a>
        </div>
    </div>
</div>
